# NAKSHATRA Environment Variables

# Primary AI Model Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_PRO_MODEL="gemini-2.5-pro"

# Database Configuration (PostgreSQL with pgvector)
# If left empty in local development, NAKSHATRA automatically boots an embedded PostgreSQL (PGlite) instance with vector support
DATABASE_URL="postgres://postgres:postgres@localhost:5432/nakshatra"

# Newsroom Admin Security
ADMIN_API_SECRET="change-this-to-a-secure-random-token"

# Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
